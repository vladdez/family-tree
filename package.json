{
  "name": "mikheev-family-tree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "validate-data": "node --import tsx scripts/validate-data.ts",
    "check": "astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "npm run validate-data && npm run check && astro build && npm run verify-build",
    "verify-build": "node --import tsx scripts/check-build.ts",
    "preview": "astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "astro": "7.3.2",
    "@astrojs/react": "6.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "6.0.3",
    "tsx": "4.23.13",
    "parse5": "8.0.1"
  }
}
