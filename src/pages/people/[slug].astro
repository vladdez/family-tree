---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import PersonHeader from '../../components/person/PersonHeader.astro';
import PhotoAlbum from '../../components/person/PhotoAlbum.astro';
import Biography from '../../components/person/Biography.astro';
import InlineText from '../../components/person/InlineText.astro';
import ProfileSources from '../../components/person/ProfileSources.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import RelationshipList from '../../components/person/RelationshipList.astro';
import Timeline from '../../components/person/Timeline.astro';
import SourceNotes from '../../components/person/SourceNotes.astro';
import UnidentifiedRelatives from '../../components/person/UnidentifiedRelatives.astro';
import DocumentCard from '../../components/documents/DocumentCard.astro';
import { catalog } from '../../domain/catalog';
import { displayName, personDescription, eventDate, lifespan, showBirthOnly } from '../../domain/people';
import { getRelativeGroups } from '../../domain/relationships';
import { getProfileDocuments } from '../../domain/documents';
import { getTimeline } from '../../domain/timeline';
import { getProfileFootnotes } from '../../domain/profile-footnotes';
import { getPublicSourceIssues, getUnidentifiedRelatives } from '../../domain/source-notes';
import { url, personUrl } from '../../domain/urls';
import { getPersonRedirects } from '../../domain/person-redirects';
import { placeNameForEvent, settlementNameForEvent } from '../../domain/places';
import type { Person } from '../../domain/schemas';
import personRedirects from '../../data/person-redirects.json';
export function getStaticPaths() { return [
  ...catalog.people.map((person) => ({ params: { slug: person.slug }, props: { person, redirect: false } })),
  ...getPersonRedirects(catalog, personRedirects).map(({ from, person }) => ({ params: { slug: from }, props: { person, redirect: true } })),
]; }
const { person, redirect } = Astro.props;
const groups = getRelativeGroups(person.id, catalog);
const { photographs, documents } = getProfileDocuments(person.id, catalog);
const timeline = getTimeline(person.id, catalog);
const footnotes = getProfileFootnotes(person, timeline, catalog);
const hasNotes = Boolean(person.notes || getPublicSourceIssues(person.id, catalog).length || getUnidentifiedRelatives(catalog, person.id).length);
const place = (id: string | null) => id ? catalog.places.find((p) => p.id === id) : undefined;
const placeName = (event: Person['birth']) => placeNameForEvent(place(event.placeId), event);
const currentPlaceName = (event: Person['birth']) => {
  const location = place(event.placeId);
  return location && settlementNameForEvent(location, event) !== location.name ? location.name : '';
};
const name = displayName(person, catalog);
---
<BaseLayout title={`${name} · ${lifespan(person)} — Родословная Михеевых`} description={personDescription(person, catalog)} image={person.portrait} canonicalPath={`/people/${person.slug}/`}>
  <Fragment slot="head">{redirect && <><meta http-equiv="refresh" content={`0;url=${personUrl(person.slug)}`} /><meta name="robots" content="noindex, follow" /></>}</Fragment>
  {redirect ? <><PageHeader eyebrow="Семейный архив" title={name} description="Сведения об этом человеке объединены в одну личную запись." /><a class="button" href={personUrl(person.slug)}>Открыть личную страницу ↗</a></> : <>
  <Breadcrumbs items={[{ label: 'Люди', path: '/people/' }, { label: name }]} /><PersonHeader person={person} />
  <div class="person-content"><div>
    <section class="section"><h2>Биография</h2><Biography biography={person.biography} footnotes={footnotes} /></section>
    {hasNotes && <section class="section"><h2>Примечания</h2>{person.notes && <p class="note prose"><InlineText text={person.notes} footnotes={footnotes} /></p>}<SourceNotes personId={person.id} /><UnidentifiedRelatives personId={person.id} showHeading={false} /></section>}
    <section class="section"><h2>Хронология</h2><Timeline events={timeline} footnotes={footnotes} /></section>
    <PhotoAlbum photographs={photographs} />
    {documents.length > 0 && <section class="section" aria-labelledby="document-trail-title"><div class="section-head"><h2 id="document-trail-title">Документальный след</h2><span class="muted">Документов: {documents.length}</span></div><div class="document-list">{documents.map((document) => <DocumentCard document={document} />)}</div></section>}
    <section class="section"><h2>Связанные люди</h2><div class="cards">{groups.map((group) => <RelationshipList {...group} />)}</div><div class="actions"><a class="button" href={url('/tree/')}>Вернуться к древу ↗</a></div></section>
    <ProfileSources sources={footnotes} />
  </div><aside><dl class="facts"><div><dt>Рождение</dt><dd>{eventDate(person.birth)}<br /><span class="muted">{placeName(person.birth)}</span>{currentPlaceName(person.birth) && <small class="muted"><br />Ныне {currentPlaceName(person.birth)}</small>}</dd></div>{!showBirthOnly(person) && <div><dt>Смерть</dt><dd>{eventDate(person.death)}{person.death.placeId && <><br /><span class="muted">{placeName(person.death)}</span>{currentPlaceName(person.death) && <small class="muted"><br />Ныне {currentPlaceName(person.death)}</small>}</>}{person.death.notes && <p class="muted">{person.death.notes}</p>}</dd></div>}</dl></aside></div>
  </>}
</BaseLayout>
