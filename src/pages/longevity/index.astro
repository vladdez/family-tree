---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { catalog } from '../../domain/catalog';
import { buildLongevityReport, fiveNumberSummary, type LongevityBranchDefinition, type LongevityGroup } from '../../domain/longevity';
import { displayName, lifespan } from '../../domain/people';
import { personUrl } from '../../domain/urls';
import branchData from '../../data/tree-branches.json';

const report = buildLongevityReport(catalog, branchData as LongevityBranchDefinition[]);
const number = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 });
const years = (value: number | null) => value === null ? '—' : `≈ ${number.format(value)}`;
const sortedRecords = [...report.records].sort((a, b) => b.midpoint - a.midpoint || b.max - a.max || displayName(a.person, catalog).localeCompare(displayName(b.person, catalog), 'ru'));
const scale = Math.max(1, ...sortedRecords.map((record) => record.midpoint));
const branchLabel = (ids: string[]) => ids.map((id) => report.branches.find((branch) => branch.id === id)?.label.split(' — ')[0]).filter(Boolean).join(', ');
const plotGroup = (group: LongevityGroup, label: string) => ({
  id: group.id,
  label,
  mean: group.average,
  summary: fiveNumberSummary(group.records.map((record) => record.midpoint)),
  points: group.records.map((record) => ({
    id: record.person.id,
    name: displayName(record.person, catalog),
    href: personUrl(record.person.slug),
    years: lifespan(record.person),
    age: record.midpoint,
    ageLabel: record.label,
  })),
});
const plotData = {
  sex: report.sexes.filter((group) => group.id === 'male' || group.id === 'female').map((group) => plotGroup(group, group.label)),
  lineage: report.branches.map((group) => plotGroup(group, group.id === 'paternal' ? 'По отцу' : 'По матери')),
};
---
<BaseLayout title="Живучесть предков — Родословная Михеевых" description="Продолжительность жизни прямых предков Владимира Михеева: средний и медианный возраст, сравнение семейных ветвей и пола.">
  <PageHeader eyebrow="Статистика поколений" title="Живучесть" description="Продолжительность жизни прямых предков Владимира Михеева по датам, которые уже подтверждены или отмечены в семейном архиве как варианты." />

  <section class="longevity-stats" aria-label="Основные показатели">
    <article class="longevity-stat"><strong>{report.records.length}</strong><span>предков с двумя датами</span></article>
    <article class="longevity-stat"><strong>{years(report.average)}</strong><span>средняя продолжительность</span></article>
    <article class="longevity-stat"><strong>{years(report.median)}</strong><span>медианный возраст</span></article>
    {report.longest && <article class="longevity-stat"><strong>{report.longest.label}</strong><span>самая долгая жизнь · <a href={personUrl(report.longest.person.slug)}>{displayName(report.longest.person, catalog)}</a></span></article>}
  </section>

  <p class="note section methodology">Возраст с символом «≈» рассчитан по годам, потому что точный день рождения или смерти неизвестен. При нескольких вариантах дат показан диапазон. Средние значения вычислены по середине такого диапазона. Для сравнения по полу использовано заполненное поле пола или явная родственная роль «отец»/«мать»; по имени пол не определяется.</p>

  <section class="section" aria-labelledby="lifespans-title">
    <div class="section-head">
      <div><p class="eyebrow">От большего к меньшему</p><h2 id="lifespans-title">Годы жизни предков</h2></div>
      <p class="muted sample-note">{report.records.length} из {report.ancestors.length} прямых предков имеют достаточно данных</p>
    </div>
    <ol class="lifespan-chart">
      {sortedRecords.map((record) => (
        <li class:list={['lifespan-row', ...record.branchIds.map((id) => `branch-${id}`)]}>
          <div class="lifespan-person">
            <a href={personUrl(record.person.slug)}>{displayName(record.person, catalog)}</a>
            <span>{lifespan(record.person)} · {branchLabel(record.branchIds)}</span>
          </div>
          <div class="lifespan-bar" aria-hidden="true"><span style={`width: ${(record.midpoint / scale) * 100}%`}></span></div>
          <strong>{record.label} <small>лет</small></strong>
        </li>
      ))}
    </ol>
  </section>

  <section class="section comparisons" aria-labelledby="comparison-title">
    <div class="section-head"><div><p class="eyebrow">Срезы выборки</p><h2 id="comparison-title">Сравнение</h2></div></div>
    <div class="comparison-grid">
      <div class="comparison-block">
        <h3>По семейной ветви</h3>
        {report.branches.map((branch) => (
          <article class:list={['comparison-card', `branch-${branch.id}`]}>
            <div><strong>{branch.label}</strong><span>{branch.records.length} чел.</span></div>
            <dl><div><dt>Среднее</dt><dd>{years(branch.average)} лет</dd></div><div><dt>Медиана</dt><dd>{years(branch.median)} лет</dd></div></dl>
          </article>
        ))}
      </div>
      <div class="comparison-block">
        <h3>По полу</h3>
        {report.sexes.map((sex) => (
          <article class:list={['comparison-card', `sex-${sex.id}`]}>
            <div><strong>{sex.label}</strong><span>{sex.records.length} чел.</span></div>
            <dl><div><dt>Среднее</dt><dd>{years(sex.average)} лет</dd></div><div><dt>Медиана</dt><dd>{years(sex.median)} лет</dd></div></dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section boxplot-section" aria-labelledby="boxplot-title">
    <div class="section-head">
      <div><p class="eyebrow">Интерактивная диаграмма</p><h2 id="boxplot-title">Распределение продолжительности жизни</h2></div>
      <div class="plot-controls">
        <fieldset class="plot-switcher">
          <legend>Группировать</legend>
          <label><input type="radio" name="plot-group" value="sex" checked /> Пол</label>
          <label><input type="radio" name="plot-group" value="lineage" /> Род</label>
        </fieldset>
        <fieldset class="plot-options">
          <legend>Показывать</legend>
          <label><input type="checkbox" name="plot-metric" value="median" checked /> Медиана</label>
          <label><input type="checkbox" name="plot-metric" value="mean" checked /> Среднее</label>
        </fieldset>
      </div>
    </div>
    <div class="boxplot-stage" id="longevity-boxplot">
      <svg class="longevity-boxplot-svg" viewBox="0 0 960 520" role="img" aria-label="Диаграмма продолжительности жизни предков"></svg>
      <div class="boxplot-tooltip" id="longevity-tooltip" role="tooltip" hidden></div>
    </div>
    <p class="plot-help">Коробка показывает квартильный диапазон, линия внутри — медиану, «усы» — минимальный и максимальный возраст. Каждая точка — отдельный предок. Наведите на неё для подробностей или нажмите, чтобы открыть карточку.</p>
    <noscript><p class="note">Для интерактивной диаграммы необходимо включить JavaScript.</p></noscript>
  </section>

  <script is:inline define:vars={{ plotData }}>
  const stage = document.querySelector('#longevity-boxplot');
  const svg = stage?.querySelector('svg');
  const tooltip = document.querySelector('#longevity-tooltip');
  const namespace = 'http://www.w3.org/2000/svg';
  const width = 960;
  const height = 520;
  const margin = { top: 38, right: 42, bottom: 86, left: 74 };
  const chartHeight = height - margin.top - margin.bottom;
  const createSvg = (name, attributes = {}, content = '') => {
    const element = document.createElementNS(namespace, name);
    for (const [key, value] of Object.entries(attributes)) element.setAttribute(key, String(value));
    if (content) element.textContent = content;
    return element;
  };
  const formatAge = (value) => new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 }).format(value);
  const showTooltip = (point, target, event) => {
    if (!tooltip || !stage) return;
    const title = document.createElement('strong');
    title.textContent = point.name;
    const dates = document.createElement('span');
    dates.textContent = point.years;
    const age = document.createElement('span');
    age.textContent = `${point.ageLabel} лет`;
    tooltip.replaceChildren(title, dates, age);
    tooltip.hidden = false;
    const stageRect = stage.getBoundingClientRect();
    const targetRect = target.getBoundingClientRect();
    const left = event?.clientX ? event.clientX - stageRect.left : targetRect.left - stageRect.left + targetRect.width / 2;
    const top = event?.clientY ? event.clientY - stageRect.top : targetRect.top - stageRect.top;
    tooltip.style.left = `${Math.min(Math.max(left + 14, 8), stageRect.width - tooltip.offsetWidth - 8)}px`;
    tooltip.style.top = `${Math.max(top - tooltip.offsetHeight - 12, 8)}px`;
  };
  const hideTooltip = () => { if (tooltip) tooltip.hidden = true; };
  const activeMode = () => document.querySelector('input[name="plot-group"]:checked')?.value ?? 'sex';
  const enabledMetrics = () => new Set([...document.querySelectorAll('input[name="plot-metric"]:checked')].map((input) => input.value));
  const draw = (mode) => {
    if (!svg) return;
    svg.replaceChildren();
    const groups = plotData[mode];
    const metrics = enabledMetrics();
    const values = groups.flatMap((group) => group.points.map((point) => point.age));
    const axisMin = Math.max(0, Math.floor(Math.min(...values) / 10) * 10 - 10);
    const axisMax = Math.ceil(Math.max(...values) / 10) * 10;
    const y = (value) => margin.top + ((axisMax - value) / (axisMax - axisMin)) * chartHeight;
    const plotWidth = width - margin.left - margin.right;
    const centers = groups.map((_, index) => margin.left + plotWidth * ((index + 0.5) / groups.length));
    const palette = mode === 'sex' ? ['male', 'female'] : ['paternal', 'maternal'];

    for (let tick = axisMin; tick <= axisMax; tick += 10) {
      svg.append(createSvg('line', { class: 'boxplot-grid', x1: margin.left, x2: width - margin.right, y1: y(tick), y2: y(tick) }));
      svg.append(createSvg('text', { class: 'boxplot-tick', x: margin.left - 14, y: y(tick) + 5, 'text-anchor': 'end' }, String(tick)));
    }
    svg.append(createSvg('text', { class: 'boxplot-axis-title', x: 20, y: margin.top + chartHeight / 2, transform: `rotate(-90 20 ${margin.top + chartHeight / 2})`, 'text-anchor': 'middle' }, 'Возраст, лет'));

    groups.forEach((group, groupIndex) => {
      if (!group.summary) return;
      const center = centers[groupIndex];
      const colorClass = `boxplot-${palette[groupIndex]}`;
      const boxWidth = Math.min(170, plotWidth / groups.length * 0.42);
      const summary = group.summary;
      svg.append(createSvg('line', { class: `boxplot-whisker ${colorClass}`, x1: center, x2: center, y1: y(summary.max), y2: y(summary.min) }));
      svg.append(createSvg('line', { class: `boxplot-whisker ${colorClass}`, x1: center - boxWidth * 0.28, x2: center + boxWidth * 0.28, y1: y(summary.max), y2: y(summary.max) }));
      svg.append(createSvg('line', { class: `boxplot-whisker ${colorClass}`, x1: center - boxWidth * 0.28, x2: center + boxWidth * 0.28, y1: y(summary.min), y2: y(summary.min) }));
      svg.append(createSvg('rect', { class: `boxplot-box ${colorClass}`, x: center - boxWidth / 2, y: y(summary.q3), width: boxWidth, height: Math.max(2, y(summary.q1) - y(summary.q3)), rx: 8 }));
      if (metrics.has('median')) svg.append(createSvg('line', { class: `boxplot-median ${colorClass}`, x1: center - boxWidth / 2, x2: center + boxWidth / 2, y1: y(summary.median), y2: y(summary.median) }));
      if (metrics.has('mean') && group.mean !== null) {
        const meanY = y(group.mean);
        const size = 10;
        svg.append(createSvg('polygon', { class: `boxplot-mean ${colorClass}`, points: `${center},${meanY - size} ${center + size},${meanY} ${center},${meanY + size} ${center - size},${meanY}` }));
      }

      const spacing = group.points.length > 1 ? Math.min(24, (boxWidth * 0.82) / (group.points.length - 1)) : 0;
      group.points.slice().sort((a, b) => a.age - b.age).forEach((point, pointIndex) => {
        const jitter = (pointIndex - (group.points.length - 1) / 2) * spacing;
        const link = createSvg('a', { href: point.href, class: 'boxplot-person-link', 'aria-label': `${point.name}, ${point.ageLabel} лет` });
        const circle = createSvg('circle', { class: `boxplot-point ${colorClass}`, cx: center + jitter, cy: y(point.age), r: 8 });
        link.append(circle);
        link.addEventListener('pointerenter', (event) => showTooltip(point, circle, event));
        link.addEventListener('pointermove', (event) => showTooltip(point, circle, event));
        link.addEventListener('pointerleave', hideTooltip);
        link.addEventListener('focus', () => showTooltip(point, circle));
        link.addEventListener('blur', hideTooltip);
        svg.append(link);
      });

      svg.append(createSvg('text', { class: 'boxplot-group-label', x: center, y: height - 48, 'text-anchor': 'middle' }, group.label));
      const details = [`n = ${group.points.length}`];
      if (metrics.has('median')) details.push(`медиана ${formatAge(summary.median)}`);
      if (metrics.has('mean') && group.mean !== null) details.push(`среднее ${formatAge(group.mean)}`);
      svg.append(createSvg('text', { class: 'boxplot-group-count', x: center, y: height - 25, 'text-anchor': 'middle' }, details.join(' · ')));
    });
  };
  document.querySelectorAll('input[name="plot-group"]').forEach((input) => input.addEventListener('change', (event) => {
    if (event.currentTarget.checked) draw(event.currentTarget.value);
  }));
  document.querySelectorAll('input[name="plot-metric"]').forEach((input) => input.addEventListener('change', () => draw(activeMode())));
  draw('sex');
  </script>
</BaseLayout>

<style>
  .longevity-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-block: var(--border-width) solid var(--color-border); padding-block: var(--space-xl); }
  .longevity-stat { min-width: 0; padding-inline: var(--space-xl); border-left: var(--border-width) solid var(--color-border); }
  .longevity-stat:first-child { border-left: 0; padding-left: 0; }
  .longevity-stat strong { display: block; font: var(--font-2xl)/1.15 var(--font-heading); }
  .longevity-stat span { display: block; margin-top: var(--space-xs); color: var(--color-muted); font-size: var(--font-sm); }
  .longevity-stat a { color: var(--color-accent); }
  .methodology { max-width: none; }
  .sample-note { max-width: 22rem; font-size: var(--font-sm); text-align: right; }
  .lifespan-chart { display: grid; }
  .lifespan-row { display: grid; grid-template-columns: minmax(14rem, 1.2fr) minmax(10rem, 2fr) 5.5rem; gap: var(--space-lg); align-items: center; padding-block: var(--space-md); border-top: var(--border-width) solid var(--color-border); }
  .lifespan-row:last-child { border-bottom: var(--border-width) solid var(--color-border); }
  .lifespan-person { min-width: 0; }
  .lifespan-person a { font-family: var(--font-heading); font-size: var(--font-lg); text-decoration: none; }
  .lifespan-person a:hover { color: var(--color-accent); text-decoration: underline; }
  .lifespan-person span { display: block; color: var(--color-muted); font-size: var(--font-xs); }
  .lifespan-bar { height: var(--space-md); background: var(--color-soft); border-radius: var(--radius-round); overflow: hidden; }
  .lifespan-bar span { display: block; height: 100%; border-radius: inherit; background: var(--color-tree-paternal-border); }
  .branch-maternal .lifespan-bar span { background: var(--color-tree-maternal-border); }
  .lifespan-row > strong { justify-self: end; font: var(--font-xl)/1 var(--font-heading); white-space: nowrap; }
  .lifespan-row > strong small { font: var(--font-xs) var(--font-body); color: var(--color-muted); }
  .comparison-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2xl); }
  .comparison-block { display: grid; align-content: start; gap: var(--space-md); }
  .comparison-block h3 { margin-bottom: var(--space-xs); }
  .comparison-card { padding: var(--space-lg); border: var(--border-width) solid var(--color-border); border-left: 0.35rem solid var(--color-accent); background: var(--color-surface); }
  .comparison-card.branch-paternal { border-left-color: var(--color-tree-paternal-border); }
  .comparison-card.branch-maternal { border-left-color: var(--color-tree-maternal-border); }
  .comparison-card > div { display: flex; justify-content: space-between; gap: var(--space-md); }
  .comparison-card > div span { color: var(--color-muted); font-size: var(--font-sm); }
  .comparison-card dl { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-md); margin: var(--space-lg) 0 0; }
  .comparison-card dl div { border-top: var(--border-width) solid var(--color-border); padding-top: var(--space-sm); }
  .comparison-card dt { color: var(--color-muted); font-size: var(--font-xs); text-transform: uppercase; letter-spacing: 0.08em; }
  .comparison-card dd { margin: var(--space-2xs) 0 0; font-family: var(--font-heading); font-size: var(--font-lg); }
  .boxplot-section .section-head { align-items: center; }
  .plot-controls { display: grid; gap: var(--space-sm); justify-items: end; }
  .plot-switcher { display: flex; gap: var(--space-xs); margin: 0; padding: var(--space-2xs); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-round); background: var(--color-surface); }
  .plot-switcher legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .plot-switcher label { position: relative; cursor: pointer; }
  .plot-switcher input { position: absolute; opacity: 0; pointer-events: none; }
  .plot-switcher label { display: block; min-width: 5.5rem; padding: var(--space-xs) var(--space-md); border-radius: var(--radius-round); color: var(--color-muted); text-align: center; font-size: var(--font-sm); transition: color var(--transition), background var(--transition); }
  .plot-switcher label:has(input:checked) { color: var(--color-accent-text); background: var(--color-accent); }
  .plot-switcher label:has(input:focus-visible) { box-shadow: var(--shadow-focus); }
  .plot-options { display: flex; gap: var(--space-md); margin: 0; padding: 0; border: 0; }
  .plot-options legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .plot-options label { display: flex; align-items: center; gap: var(--space-xs); color: var(--color-muted); cursor: pointer; font-size: var(--font-sm); }
  .plot-options input { width: 1rem; height: 1rem; margin: 0; accent-color: var(--color-accent); }
  .boxplot-stage { position: relative; padding: var(--space-md); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-small); background: var(--color-surface); overflow: hidden; }
  :global(.longevity-boxplot-svg) { display: block; width: 100%; height: auto; min-height: 24rem; }
  :global(.boxplot-grid) { stroke: var(--color-grid); stroke-width: 1; }
  :global(.boxplot-tick), :global(.boxplot-axis-title), :global(.boxplot-group-count) { fill: var(--color-muted); font: 13px var(--font-body); }
  :global(.boxplot-group-label) { fill: var(--color-text); font: 21px var(--font-heading); }
  :global(.boxplot-whisker), :global(.boxplot-median) { stroke-width: 3; }
  :global(.boxplot-mean) { stroke-width: 2; }
  :global(.boxplot-box) { stroke-width: 2; }
  :global(.boxplot-male), :global(.boxplot-paternal) { stroke: var(--color-tree-paternal-border); fill: var(--color-tree-paternal-background); }
  :global(.boxplot-female), :global(.boxplot-maternal) { stroke: var(--color-tree-maternal-border); fill: var(--color-tree-maternal-background); }
  :global(.boxplot-point) { stroke-width: 2; transition: r var(--transition), filter var(--transition); }
  :global(.boxplot-person-link:hover .boxplot-point), :global(.boxplot-person-link:focus .boxplot-point) { r: 11; filter: drop-shadow(0 2px 3px rgb(41 46 41 / 25%)); }
  :global(.boxplot-person-link:focus) { outline: none; }
  .boxplot-tooltip { position: absolute; z-index: 2; display: grid; gap: var(--space-2xs); width: max-content; max-width: min(18rem, calc(100% - 1rem)); padding: var(--space-sm) var(--space-md); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-small); background: var(--color-text); color: var(--color-accent-text); box-shadow: var(--shadow-card); pointer-events: none; font-size: var(--font-sm); }
  .boxplot-tooltip span { color: var(--color-soft); font-size: var(--font-xs); }
  .plot-help { max-width: var(--reading-width); margin-top: var(--space-md); color: var(--color-muted); font-size: var(--font-sm); }
  @media (max-width: 800px) {
    .longevity-stats { grid-template-columns: repeat(2, 1fr); gap: var(--space-xl) 0; }
    .longevity-stat:nth-child(3) { border-left: 0; padding-left: 0; }
    .lifespan-row { grid-template-columns: minmax(0, 1fr) 4.5rem; gap: var(--space-sm) var(--space-md); }
    .lifespan-bar { grid-column: 1 / -1; grid-row: 2; }
    .lifespan-row > strong { grid-column: 2; grid-row: 1; }
    .comparison-grid { grid-template-columns: 1fr; }
    .boxplot-section .section-head { align-items: start; }
    .plot-controls { justify-items: start; }
  }
  @media (max-width: 480px) {
    .longevity-stat { padding-inline: var(--space-md); }
    .longevity-stat strong { font-size: var(--font-xl); }
    .section-head .sample-note { text-align: left; }
  }
</style>
