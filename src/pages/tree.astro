---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import GenealogyTree from '../components/genealogy/GenealogyTree';
import UnidentifiedRelatives from '../components/person/UnidentifiedRelatives.astro';
import { catalog } from '../domain/catalog';
import { getFocusedTree } from '../domain/focused-tree';
import { getTreeBranches } from '../domain/tree-branches';
import branchRoots from '../data/tree-branches.json';
import treeSettings from '../data/tree-view.json';
const graph = getFocusedTree(catalog, treeSettings);
const branches = getTreeBranches(graph.people, graph.relationships, branchRoots);
---
<BaseLayout title="Семейное древо — Родословная Михеевых" description="Интерактивное семейное древо Михеевых. Найдите человека и откройте его историю, даты жизни и документы.">
  <PageHeader eyebrow="Владимир Юрьевич Михеев" title="Семейное древо" description="В центре — Владимир, его отец Юрий и мать Эльвира. Рядом — сёстры Ксения и Мария. Выше — прямые предки и их супруги: отцовская ветвь слева, материнская справа." />
  <p class="note">Братья, сёстры и кузены предков собраны внутри их карточек. Нажмите «Родственники», чтобы раскрыть имена. Люди одной эпохи находятся на одном уровне.</p>
  {!graph.relationships.length && <p class="note tree-notice">Сейчас показаны отдельные семейные записи. Родственные связи пока не уточнены; линии появятся после их подтверждения.</p>}
  <GenealogyTree {...graph} branches={branches} client:load />
  <p class="note section">Если год рождения неизвестен, положение карточки определяется по родственникам. Пунктирные линии обозначают предполагаемые связи.</p>
  <details class="section"><summary>Родственники с неизвестными именами — заметки семейных источников</summary><UnidentifiedRelatives /></details>
  <noscript><p class="note section">Имена доступны как ссылки. Для перемещения и масштабирования древа включите JavaScript.</p></noscript>
</BaseLayout>
