---
import BaseLayout from '../components/layout/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import GenealogyTree from '../components/genealogy/GenealogyTree';
import UnidentifiedRelatives from '../components/person/UnidentifiedRelatives.astro';
import { catalog } from '../domain/catalog';
import { getTreeData } from '../domain/relationships';
const graph = getTreeData(catalog);
---
<BaseLayout title="Семейное древо — Родословная Михеевых" description="Интерактивное семейное древо Михеевых. Найдите человека и откройте его историю, даты жизни и документы.">
  <PageHeader eyebrow="Имена и связи" title="Семейное древо" description="Люди одной эпохи находятся на одном уровне. Слева — периоды по известным годам рождения. Приближайте древо и открывайте историю каждого человека." />
  {!graph.relationships.length && <p class="note tree-notice">Сейчас показаны отдельные семейные записи. Родственные связи пока не уточнены; линии появятся после их подтверждения.</p>}
  <GenealogyTree people={graph.people} relationships={graph.relationships} client:load />
  <p class="note section">Если год рождения неизвестен, положение карточки определяется по родственникам и отмечено «Положение по родству». Пунктирные линии обозначают предполагаемые связи. Неполнородное родство показано отдельной линией без добавления неизвестного общего родителя. Возможное совпадение записей не объединяет людей автоматически.</p>
  <UnidentifiedRelatives />
  <noscript><p class="note section">Имена доступны как ссылки. Для перемещения и масштабирования древа включите JavaScript.</p></noscript>
</BaseLayout>
