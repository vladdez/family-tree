---
import type { FamilyDocument } from '../../domain/schemas';
import { documentTypes } from '../../domain/schemas';
import { isImage } from '../../domain/documents';
import { formatDate } from '../../domain/dates';
import { documentUrl, url } from '../../domain/urls';
import { catalog } from '../../domain/catalog';
import { personSearchText, getPerson } from '../../domain/people';
import PersonLink from '../person/PersonLink.astro';
import ArchiveReference from './ArchiveReference.astro';
interface Props { document: FamilyDocument }
const { document } = Astro.props;
const thumbnail = document.files.find((file) => isImage(file.path));
const searchable = [document.title, ...document.peopleIds.map((id) => personSearchText(getPerson(id, catalog)))].join(' ').toLocaleLowerCase('ru').replaceAll('ё', 'е');
---
<article class="document-card" data-document-type={document.type} data-document-search={searchable}>
  <div class="document-card-head"><span class="eyebrow">{documentTypes[document.type]}</span><span class="muted">{formatDate(document.date)}</span></div>
  {thumbnail && <a class="document-thumbnail" href={documentUrl(document.id)}><img src={url(thumbnail.preview ?? thumbnail.path)} alt={thumbnail.label} loading="lazy" /></a>}
  <h3><a href={documentUrl(document.id)}>{document.title}</a></h3><ArchiveReference archive={document.archive} />
  <ul class="document-people">{document.peopleIds.map((id) => <li><PersonLink personId={id} /></li>)}</ul>
  <a class="text-link" href={documentUrl(document.id)}>Открыть документ →</a>
</article>
