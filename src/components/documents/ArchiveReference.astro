---
import type { FamilyDocument } from '../../domain/schemas';
interface Props { archive: FamilyDocument['archive']; documentType: FamilyDocument['type'] }
const { archive, documentType } = Astro.props;
const name = documentType === 'photograph' && archive.name === 'Семейный архив' ? '' : archive.name;
const parts = [[archive.fond, 'Фонд'], [archive.opis, 'Опись'], [archive.delo, 'Дело'], [archive.page, 'Лист']].filter(([value]) => value);
---
{(name || parts.length > 0) && <div class="archive-reference">{name && <p>{name}</p>}{parts.length > 0 && <p>{parts.map(([value, label]) => `${label} ${value}`).join(' · ')}</p>}</div>}
