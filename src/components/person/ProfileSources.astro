---
import type { ProfileFootnote } from '../../domain/profile-footnotes';
import { url } from '../../domain/urls';
interface Props { sources: ProfileFootnote[] }
const { sources } = Astro.props;
---
{sources.length > 0 && <section class="section profile-footnotes" aria-labelledby="sources-title"><h2 id="sources-title">Источники</h2><ol>{sources.map((source) => <li id={`source-${source.number}`} data-footnote><a class="text-link" href={url(source.href)}>{source.title}</a>{source.pages && <span class="muted"> · стр. {source.pages}</span>}</li>)}</ol></section>}
