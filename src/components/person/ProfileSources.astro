---
import type { Person } from '../../domain/schemas';
import { url } from '../../domain/urls';
interface Props { sources: Person['sources'] }
const { sources } = Astro.props;
---
{sources.length > 0 && <div class="section"><h3>Источники биографии</h3><ul>{sources.map((source) => <li><a class="text-link" href={url(source.href)}>{source.title}</a>{source.pages && <span class="muted"> · стр. {source.pages}</span>}</li>)}</ul></div>}
