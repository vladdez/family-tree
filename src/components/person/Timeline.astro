---
import type { TimelineEntry } from '../../domain/timeline';
import TimelineEvent from './TimelineEvent.astro';
import type { ProfileFootnote } from '../../domain/profile-footnotes';
interface Props { events: TimelineEntry[]; footnotes?: ProfileFootnote[] }
const { events, footnotes = [] } = Astro.props;
---
<ol class="timeline" role="list">{events.map((event) => <TimelineEvent event={event} footnotes={footnotes} />)}</ol>
