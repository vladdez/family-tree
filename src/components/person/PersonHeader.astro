---
import type { Person } from '../../domain/schemas';
import { catalog } from '../../domain/catalog';
import { displayName, lifespan } from '../../domain/people';
import { url, personUrl } from '../../domain/urls';
interface Props { person: Person }
const { person } = Astro.props;
const name = displayName(person, catalog);
---
<header class="person-header">
  <div class="portrait">{person.portrait ? <img src={url(person.portrait)} alt={`Портрет: ${name}`} /> : <><span class="monogram" aria-hidden="true">{name[0]}</span><small>Фотография пока не добавлена</small></>}</div>
  <div><p class="eyebrow">Человек в семейном архиве</p><h1>{name}</h1><p class="lifespan">{lifespan(person)}</p>{person.archivalName && <p class="muted">Имя сохранено в архивном написании.</p>}{person.maidenName && <p class="muted">Девичья фамилия: {person.maidenName}</p>}{person.alternateNames.length > 0 && <div class="person-aliases"><span class="muted">Другие имена</span><ul>{person.alternateNames.map((alternateName) => <li><a class="person-link" href={personUrl(person.slug)}>{alternateName}</a></li>)}</ul></div>}{(person.birth.alternatives.length > 0 || person.death.alternatives.length > 0) && <p><span class="badge">Даты требуют уточнения</span></p>}{person.summary && <p class="muted">{person.summary}</p>}</div>
</header>
