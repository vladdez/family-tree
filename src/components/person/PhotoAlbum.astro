---
import type { FamilyDocument } from '../../domain/schemas';
import { isImage } from '../../domain/documents';
import { formatDate } from '../../domain/dates';
import { documentUrl, url } from '../../domain/urls';
interface Props { photographs: FamilyDocument[]; headingLevel?: 'h1' | 'h2'; layout?: 'carousel' | 'grid' }
const { photographs, headingLevel = 'h2', layout = 'carousel' } = Astro.props;
const isGrid = layout === 'grid';
const Heading = headingLevel;
const PhotoHeading = headingLevel === 'h1' ? 'h2' : 'h3';
const imagesFor = (document: FamilyDocument) => document.files.filter((file) => isImage(file.preview ?? file.path));
const photos = photographs.flatMap((document) => imagesFor(document).map((file) => ({ document, file })));
const attachments = photographs.filter((document) => imagesFor(document).length === 0);
---
{photographs.length > 0 && <section class:list={['section', 'photo-album', { 'photo-album-grid': isGrid }]} aria-labelledby="photo-album-title">
  <photo-album>
    <div class="section-head">
      <Heading id="photo-album-title">Фотоальбом</Heading>
      {!isGrid && <div class="photo-album-controls" hidden>
        <button class="button" type="button" data-direction="previous" aria-label="Предыдущие фотографии" aria-controls="photo-album-track" disabled>←</button>
        <button class="button" type="button" data-direction="next" aria-label="Следующие фотографии" aria-controls="photo-album-track">→</button>
      </div>}
    </div>
    {photos.length > 0 && <div id="photo-album-track" class="photo-album-track" tabindex={isGrid ? undefined : 0} role="region" aria-label={isGrid ? 'Фотографии' : 'Фотографии — горизонтальная прокрутка'}>
      <ul class="photo-album-list" role="list">{photos.map(({ document, file }) => <li class="photo-album-item">
        <a href={documentUrl(document.id)} class="photo-album-link">
          <div class="photo-album-image"><img src={url(file.preview ?? file.path)} alt={file.label} loading="lazy" /></div>
          <PhotoHeading class="photo-album-caption">{document.title}</PhotoHeading>
          {document.date && <time datetime={document.date}>{formatDate(document.date)}</time>}
        </a>
      </li>)}</ul>
    </div>}
    {attachments.length > 0 && <ul class="photo-album-attachments">{attachments.map((document) => <li><a class="text-link" href={documentUrl(document.id)}>{document.title}</a>{document.files.some((file) => /\.pdf$/i.test(file.path)) && <span class="muted"> · PDF</span>}</li>)}</ul>}
  </photo-album>
</section>}

<script>
  class PhotoAlbum extends HTMLElement {
    private cleanup?: () => void;
    connectedCallback() {
      if (this.cleanup) return;
      const track = this.querySelector<HTMLElement>('.photo-album-track');
      const controls = this.querySelector<HTMLElement>('.photo-album-controls');
      const previous = this.querySelector<HTMLButtonElement>('[data-direction="previous"]');
      const next = this.querySelector<HTMLButtonElement>('[data-direction="next"]');
      if (!track || !controls || !previous || !next) return;
      const events = new AbortController();
      const update = () => {
        const max = track.scrollWidth - track.clientWidth;
        controls.hidden = max <= 1;
        previous.disabled = track.scrollLeft <= 1;
        next.disabled = track.scrollLeft >= max - 1;
      };
      const move = (direction: number) => {
        const item = track.querySelector<HTMLElement>('.photo-album-item');
        const list = track.querySelector<HTMLElement>('.photo-album-list');
        const gap = list ? Number.parseFloat(getComputedStyle(list).columnGap) || 0 : 0;
        track.scrollBy({
          left: direction * ((item?.getBoundingClientRect().width ?? track.clientWidth) + gap),
          behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      };
      previous.addEventListener('click', () => move(-1), { signal: events.signal });
      next.addEventListener('click', () => move(1), { signal: events.signal });
      track.addEventListener('scroll', update, { passive: true, signal: events.signal });
      const observer = new ResizeObserver(update);
      observer.observe(track);
      update();
      this.cleanup = () => { events.abort(); observer.disconnect(); };
    }
    disconnectedCallback() { this.cleanup?.(); this.cleanup = undefined; }
  }
  if (!customElements.get('photo-album')) customElements.define('photo-album', PhotoAlbum);
</script>

<style>
  photo-album { display: block; min-width: 0; }
  .section-head { align-items: center; }
  .section-head :is(h1, h2) { margin-bottom: 0; }
  .photo-album-controls { display: flex; gap: var(--space-xs); }
  .photo-album-controls button { padding: var(--space-xs) var(--space-md); min-width: 2.75rem; min-height: 2.75rem; }
  .photo-album-controls button:disabled { opacity: 0.4; cursor: default; }
  .photo-album-track { overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: thin; padding: var(--space-xs) var(--space-xs) var(--space-md); }
  .photo-album-list { display: grid; grid-auto-flow: column; grid-auto-columns: min(82%, 20rem); gap: var(--space-md); margin: 0; padding: 0; list-style: none; }
  .photo-album-item { min-width: 0; scroll-snap-align: start; }
  .photo-album-link { display: flex; flex-direction: column; gap: var(--space-sm); height: 100%; text-decoration: none; }
  .photo-album-image { position: relative; aspect-ratio: 4 / 3; background: var(--color-soft); border: var(--border-width) solid var(--color-border); border-radius: var(--radius-small); overflow: hidden; }
  .photo-album-image img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
  .photo-album-caption { font-size: var(--font-md); line-height: 1.4; }
  .photo-album-link:hover .photo-album-caption { text-decoration: underline; }
  .photo-album-link time { color: var(--color-muted); font-size: var(--font-xs); }
  .photo-album-attachments { display: grid; gap: var(--space-sm); margin-top: var(--space-md); }
  .photo-album-grid .photo-album-track { overflow: visible; scroll-snap-type: none; }
  .photo-album-grid .photo-album-list { grid-auto-flow: row; grid-auto-columns: auto; grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: var(--space-xl); }
  @media (max-width: 900px) {
    .photo-album-grid .photo-album-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .photo-album-grid .photo-album-list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
